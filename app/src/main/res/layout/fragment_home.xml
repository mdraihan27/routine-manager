<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_medium"
            android:paddingTop="@dimen/spacing_medium"
            android:paddingBottom="100dp">

            <!-- ── Header row: title + settings button ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvHomeAppTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textAppearance="@style/TextAppearance.App.Primary.Title" />

                    <TextView
                        android:id="@+id/tvHomeDateSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_tiny"
                        android:textAppearance="@style/TextAppearance.App.Secondary.Caption" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnHomeViewCourses"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:paddingHorizontal="@dimen/spacing_small"
                    android:paddingVertical="@dimen/spacing_tiny"
                    android:text="@string/title_courses"
                    android:textAppearance="@style/TextAppearance.App.Primary.Label"
                    android:textColor="@color/text_on_surface" />
            </LinearLayout>

            <!-- ── Onboarding card ── -->
            <io.github.mdraihan27.routinemanager.core.designsystem.components.AppCard
                android:id="@+id/cardOnboarding"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_large">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/onboarding_welcome_title"
                            android:textAppearance="@style/TextAppearance.App.Primary.Title" />

                        <io.github.mdraihan27.routinemanager.core.designsystem.components.AppIconButton
                            android:id="@+id/btnDismissOnboarding"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/action_cancel" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:text="@string/onboarding_welcome_desc"
                        android:textAppearance="@style/TextAppearance.App.Secondary.Body" />

                    <io.github.mdraihan27.routinemanager.core.designsystem.components.CurvedArrowView
                        android:id="@+id/arrowOnboarding"
                        android:layout_width="match_parent"
                        android:layout_height="72dp"
                        android:layout_marginVertical="@dimen/spacing_small" />

                    <TextView
                        android:id="@+id/tvOnboardingPrompt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/onboarding_start_prompt"
                        android:textAppearance="@style/TextAppearance.App.Primary.Label" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_medium"
                        android:orientation="horizontal">

                        <io.github.mdraihan27.routinemanager.core.designsystem.components.AppButton
                            android:id="@+id/btnOnboardingAddCourse"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="@dimen/spacing_small"
                            android:text="@string/action_add_course" />

                        <io.github.mdraihan27.routinemanager.core.designsystem.components.AppButton
                            android:id="@+id/btnOnboardingStart"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/action_start" />
                    </LinearLayout>
                </LinearLayout>
            </io.github.mdraihan27.routinemanager.core.designsystem.components.AppCard>

            <!-- ── Gesture tip banner ── -->
            <io.github.mdraihan27.routinemanager.core.designsystem.components.AppCard
                android:id="@+id/cardGestureTip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_medium">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/onboarding_gesture_tip"
                        android:textAppearance="@style/TextAppearance.App.Secondary.Caption" />

                    <io.github.mdraihan27.routinemanager.core.designsystem.components.AppIconButton
                        android:id="@+id/btnDismissGestureTip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_small"
                        android:contentDescription="@string/action_cancel" />
                </LinearLayout>
            </io.github.mdraihan27.routinemanager.core.designsystem.components.AppCard>

            <!-- ── Daily class section ── -->
            <LinearLayout
                android:id="@+id/layoutClassSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:orientation="vertical"
                android:visibility="gone">

                <io.github.mdraihan27.routinemanager.core.designsystem.components.AppCard
                    android:id="@+id/cardDailyClass"
                    android:layout_width="match_parent"
                    android:layout_height="220dp">

                    <LinearLayout
                        android:id="@+id/layoutCardContent"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_large">

                        <!-- Status chip + course code row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvClassCourseCode"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textAppearance="@style/TextAppearance.App.Primary.Headline" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="center_horizontal">

                                <io.github.mdraihan27.routinemanager.core.designsystem.components.AppChip
                                    android:id="@+id/chipClassStatus"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content">

                                    <TextView
                                        android:id="@+id/tvClassStatusLabel"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:paddingHorizontal="@dimen/spacing_small"
                                        android:paddingVertical="@dimen/spacing_tiny"
                                        android:textAppearance="@style/TextAppearance.App.Primary.Label" />
                                </io.github.mdraihan27.routinemanager.core.designsystem.components.AppChip>

                                <io.github.mdraihan27.routinemanager.core.designsystem.components.AppButton
                                    android:id="@+id/btnUndoCancel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/spacing_tiny"
                                    android:text="@string/action_undo"
                                    android:visibility="gone" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Course name -->
                        <TextView
                            android:id="@+id/tvClassCourseName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_small"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:textAppearance="@style/TextAppearance.App.Primary.Title" />

                        <!-- Teacher -->
                        <TextView
                            android:id="@+id/tvClassTeacherName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_tiny"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:textAppearance="@style/TextAppearance.App.Secondary.Body" />

                        <Space
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <!-- Time + position row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_large"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvClassTime"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textAppearance="@style/TextAppearance.App.Primary.Subtitle" />

                            <TextView
                                android:id="@+id/tvClassPosition"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.App.Secondary.Caption" />
                        </LinearLayout>
                    </LinearLayout>
                </io.github.mdraihan27.routinemanager.core.designsystem.components.AppCard>

                <!-- Swipe Hint -->
                <TextView
                    android:id="@+id/tvSwipeHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:gravity="center"
                    android:text="Swipe: ←/→ to change, ↓ to cancel, ↑ to reschedule"
                    android:textAppearance="@style/TextAppearance.App.Secondary.Caption" />

                <!-- Weekly Overview -->
                <io.github.mdraihan27.routinemanager.core.designsystem.components.AppCard
                    android:id="@+id/cardWeeklyOverview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_large">
                    
                    <LinearLayout
                        android:id="@+id/layoutWeeklyOverview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_medium"
                        android:baselineAligned="false" />
                </io.github.mdraihan27.routinemanager.core.designsystem.components.AppCard>
            </LinearLayout>

            <!-- ── Holiday card ── -->
            <io.github.mdraihan27.routinemanager.core.designsystem.components.AppCard
                android:id="@+id/cardHoliday"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_large">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_holiday"
                        android:textAppearance="@style/TextAppearance.App.Primary.Title" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:text="@string/label_holiday_today"
                        android:textAppearance="@style/TextAppearance.App.Secondary.Body" />
                </LinearLayout>
            </io.github.mdraihan27.routinemanager.core.designsystem.components.AppCard>

            <!-- ── Break card ── -->
            <io.github.mdraihan27.routinemanager.core.designsystem.components.AppCard
                android:id="@+id/cardBreak"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_large">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_break_time"
                        android:textAppearance="@style/TextAppearance.App.Primary.Title" />

                    <TextView
                        android:id="@+id/tvBreakStatusMessage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:textAppearance="@style/TextAppearance.App.Secondary.Body" />
                </LinearLayout>
            </io.github.mdraihan27.routinemanager.core.designsystem.components.AppCard>

            <!-- ── No classes card ── -->
            <io.github.mdraihan27.routinemanager.core.designsystem.components.AppCard
                android:id="@+id/cardNoClasses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_large">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_no_classes_today"
                        android:textAppearance="@style/TextAppearance.App.Primary.Title" />
                </LinearLayout>
            </io.github.mdraihan27.routinemanager.core.designsystem.components.AppCard>



            <!-- ── Loading indicator ── -->
            <ProgressBar
                android:id="@+id/progressHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/spacing_large"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ── Bottom persistent action buttons ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/background"
        android:elevation="@dimen/elevation_medium"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_medium"
        android:paddingVertical="@dimen/spacing_medium">

        <ImageView
            android:id="@+id/btnBottomSettings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="@dimen/spacing_medium"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/title_settings"
            android:padding="12dp"
            android:src="@drawable/ic_settings"
            app:tint="@color/text_on_surface" />

        <io.github.mdraihan27.routinemanager.core.designsystem.components.AppButton
            android:id="@+id/btnBottomAdjustRoutine"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Adjust Routine" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
