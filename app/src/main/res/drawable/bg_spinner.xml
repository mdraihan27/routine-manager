<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="@color/surface_muted" />
            <corners android:radius="16dp" />
            <padding
                android:left="0dp"
                android:top="12dp"
                android:right="0dp"
                android:bottom="12dp" />
